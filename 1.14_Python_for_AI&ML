## Paking and Unpaking

student =("Raj", 9.9, 24)
type(student)   --> tuple

#Unpacking
name, cgpa, age = student
print(name) --> Raj
print(cgpa) --> 9.9
print(age)  --> 24

# or
name, cgpa, age = ("Raj", 9.9, 24)
print(name, age, cgpa)

def show():
