# Problem 4.
# Character Counter
# Take a string as input from the user
# Display
  # Number of vowels.
  # Number of consonants.
  # Number of digits.
  # Number of spaces.

string = input()

vowels = 0
consonent = 0
digit = 0
space = 0


for word in string:
  if word in "aeiou":
    vowels += 1

  elif word >= "a" and word <= "z":
    consonent += 1

  elif word <= "9" and word >= "0":
    digit += 1

  elif word == " ":
    space += 1

print(vowels, consonent, digit, space)

s = input()
sl = s.lower()

vowels = 0
consonant = 0
digit = 0
space = 0

for ch in sl:
  
  if ch.lower() in "aeiou":
    vowels += 1

  elif ch.isalpha():
    consonant += 1

  elif ch.isdigit():
    digit += 1

  elif ch == " ":
    space += 1

print("vowels - :", vowels)
print("consonant - :", consonant)
print("digits - :", digit)
print("spaces - :", space)


