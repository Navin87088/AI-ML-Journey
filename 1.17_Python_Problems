# Problem 1. 
# Student Grade Analyzer.
# Write a Python program that takes marks of 5 subject as input.

# Your program should 
  # Store  the marks in a list..
  # Calculate the average marks.
  # Find the highst and lowest marks.
  # Display the grade using.

marks = []

for i in range(5):
  mark = int(input())
  marks.append(mark)

avg = sum(marks)/len(marks)

print("Highest Marks -", max(marks))
print("Lowest Marks -", min(marks))
print("average - ", avg)


#Problem 2. 
# Word Frequency counter Problem statement.
# Take a sentnce as input.
# Display how many times each word appears.


s = input()
words = s.split()
print(words)

freq = {}

for word in words:
  if word not in freq:
    freq[word] = 1
  else:
    freq[word] += 1

print(freq)

