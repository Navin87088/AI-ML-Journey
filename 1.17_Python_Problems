# Word Frequency counter Problem statement.
# Take a sentnce as input.
# Display how many times each word appears.


s = input()
words = s.split()
print(words)

freq = {}

for word in words:
  if word not in freq:
    freq[word] = 1
  else:
    freq[word] += 1

print(freq)

