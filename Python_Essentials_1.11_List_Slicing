# List Slicing

a = [5,7,4,8,2,1,9]
print(a)
O/P--> [5,7,4,8,2,1,9]

print(a[1:4]
O/P --> [7,4,8]

print(a[:4])         #act as [0:4]
O/P -->  [5,7,4,8]

print(a[1:])       # it will go to the end


print(a[ : ])     # infinite list will printed (complete list)

print(a[1:5:2])   # start 1, end 5, inc 2:

print(a[ : : 2])  # 0: :2 start with 0 and inc by 2



