# def function_name():
#    definition

def greet():
  print("Hello")
O/P --> EMPTY
but
greet()  #function call
O/P --> Hello

# Write a function that prints "Hello name" for whatever name you want

def greet():
  print("Hello, Navin")
greet()
O/P --> Hello, Navin

# Code reusability

# function definition --> Parameter
# function call --> argument

def greet(name):
  print("Hello", name)
greet("Navin")
O/P --> Hello Navin

greet("Nitika")
O/P --> Hello Nitika


# Positional Arguments

def show(name, age):
  print("Name is", name)
  print("Age is", age)

show ("Monu", 22)
O/P --> Name is Monu
        Age is 22

#disadvantage

show(20,"Monu")

#computer does not care what is name what is age

O/P -->
Name is 20
Age is Monu

# Keyworded Argument

def show(name, age):
  print("Name is", name)
  print("Age is", age)

show(name = "Monu", age = 20)
O/P -->
Name is Monu
Age is 20


show(age = 22, name = "Monu")
#name matters
O/P -->
Name is Monu
Age is 22


#Return Keyword
def show(a,b):
  return a+b
s = show(2,3)
print(s)
O/P -->
5

def message():
  print("Python")  
                        # not returning any thing

x = message()

print(x)


def stars():
  print("*" * 5)

for i in range(3):
  stars()

