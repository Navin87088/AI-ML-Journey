lambda is the anonymous function(unknow identity)
lambda parameters : expression
functional programming = without writing any loops 




def cube(lst):
    
    cu = []
    
    for elem in lst:
        cu.append(elem**3)
        
    return cu
    

print(cube([1,2,3]))


A = [3,4,5]
cube = list(map(lambda x : x**3, A))
print(cube)



def Add(L):
    
    Addition = []
    
    for elem in L:
        Addition.append(elem +5)
        
    return Addition
    
print(Add([5,5,5]))


print(list(map(lambda x : x + 5, [1,2,3])))


print(list(map(lambda x : x.upper(), ["navin"])))

def upper(lst):
    case = []
    for elem in lst:
        case.append(elem.upper())
        
    return case
    
print(upper(["navin", "singh"]))
        
        
        
