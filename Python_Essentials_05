  print("Underweight")



#Write a Python program that takes an integer as input and checks its divisibility

#If the number is divisibleby both 3 And 5 : Divisible by 5 and 3
#if the number is only divisible by 3 : Divisible only by 3
#If the number is only divisible by 5 : Divisible only by 5
#Otherwise : Not divisible by 3 or 5

number = int(input())
if (number % 3 == 0) and (number % 5 == 0):
  print("Divisible by 5 and 3")
elif (number % 3 == 0) and (not(number % 5 == 0)):
  print("Divisible only by 3")
elif ((number % 5 == 0) and (not(number % 3 == 0))):
  print("Divisible only by 5")
else:
  print("Not divisible by 3 or 5")

